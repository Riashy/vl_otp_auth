<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web_login_vl_otp_auth" inherit_id="web.login" name="Web Login OTP Block">
        <xpath expr="//form[contains(@class, 'oe_login_form')]" position="after">
            <div t-if="otp_login_feature_enabled" class="o_vl_otp_login mt-4 pt-3 border-top">
                <div class="text-center small text-muted mb-3">Or log in with mobile + OTP</div>

                <t t-if="otp_error">
                    <p class="alert alert-danger" role="alert">
                        <t t-esc="otp_error"/>
                    </p>
                </t>
                <t t-if="otp_message">
                    <p class="alert alert-success" role="status">
                        <t t-esc="otp_message"/>
                    </p>
                </t>

                <form action="/vl_otp/request" method="post" class="o_vl_otp_request_form mb-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="db" t-att-value="otp_db or request.db"/>
                    <input type="hidden" name="redirect" t-att-value="otp_redirect or redirect or '/web'"/>
                    <div class="mb-3">
                        <label for="otp_mobile" class="form-label">Mobile Number</label>
                        <input type="text"
                               name="otp_mobile"
                               id="otp_mobile"
                               class="form-control"
                               t-att-value="otp_mobile"
                               placeholder="+2010XXXXXXXX"
                               required="required"
                               autocomplete="tel"/>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-outline-primary">Send OTP</button>
                    </div>
                </form>

                <form action="/vl_otp/verify" method="post" class="o_vl_otp_verify_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="db" t-att-value="otp_db or request.db"/>
                    <input type="hidden" name="redirect" t-att-value="otp_redirect or redirect or '/web'"/>
                    <div class="mb-3">
                        <label for="otp_mobile_verify" class="form-label">Mobile Number</label>
                        <input type="text"
                               name="otp_mobile"
                               id="otp_mobile_verify"
                               class="form-control"
                               t-att-value="otp_mobile"
                               placeholder="+2010XXXXXXXX"
                               required="required"
                               autocomplete="tel"/>
                    </div>
                    <div class="mb-3">
                        <label for="otp_code" class="form-label">OTP Code</label>
                        <input type="text"
                               name="otp_code"
                               id="otp_code"
                               class="form-control"
                               placeholder="123456"
                               required="required"
                               inputmode="numeric"
                               autocomplete="one-time-code"/>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Verify &amp; Log In</button>
                    </div>
                </form>
            </div>
        </xpath>
    </template>
</odoo>
