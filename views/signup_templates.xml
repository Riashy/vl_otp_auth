<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="auth_signup_vl_otp_auth_hide_standard" inherit_id="auth_signup.signup" name="Hide Standard Signup When OTP Enabled">
        <xpath expr="//form[contains(@class, 'oe_signup_form')]" position="attributes">
            <attribute name="t-if">not message and not otp_signup_feature_enabled</attribute>
        </xpath>
    </template>

    <template id="auth_signup_vl_otp_auth" inherit_id="auth_signup.signup" name="Website Signup OTP Block">
        <xpath expr="//form[contains(@class, 'oe_signup_form')]" position="after">
            <div t-if="otp_signup_feature_enabled" class="o_vl_otp_signup mt-4 pt-3 border-top">
                <div class="o_vl_otp_separator text-center small text-muted mb-3">Or sign up with email + password + mobile OTP</div>

                <t t-if="otp_signup_error">
                    <p class="alert alert-danger" role="alert">
                        <t t-esc="otp_signup_error"/>
                    </p>
                </t>
                <t t-if="otp_signup_message">
                    <p class="alert alert-success" role="status">
                        <t t-esc="otp_signup_message"/>
                    </p>
                </t>

                <div class="card shadow-sm o_vl_otp_card">
                    <div class="card-body">
                        <form action="/vl_otp/signup/request" method="post" class="mb-4">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="redirect" t-att-value="otp_signup_redirect or redirect"/>

                            <div class="mb-3">
                                <label for="otp_signup_name" class="form-label">Name</label>
                                <input type="text" name="name" id="otp_signup_name" class="form-control"
                                       t-att-value="otp_signup_name or name" required="required"/>
                            </div>
                            <div class="mb-3">
                                <label for="otp_signup_login" class="form-label">Email / Login</label>
                                <input type="text" name="login" id="otp_signup_login" class="form-control"
                                       t-att-value="otp_signup_login or login" required="required" autocapitalize="off"/>
                            </div>
                            <div class="mb-3">
                                <label for="otp_signup_mobile" class="form-label">Mobile Number</label>
                                <input type="text" name="mobile" id="otp_signup_mobile" class="form-control"
                                       t-att-value="otp_signup_mobile" placeholder="+2010XXXXXXXX" required="required"/>
                            </div>
                            <div class="mb-3">
                                <label for="otp_signup_password" class="form-label">Password</label>
                                <input type="password" name="password" id="otp_signup_password" class="form-control"
                                       required="required"/>
                            </div>
                            <div class="mb-3">
                                <label for="otp_signup_confirm_password" class="form-label">Confirm Password</label>
                                <input type="password" name="confirm_password" id="otp_signup_confirm_password" class="form-control"
                                       required="required"/>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-outline-primary">Send Signup OTP</button>
                            </div>
                        </form>

                        <form action="/vl_otp/signup/verify" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="redirect" t-att-value="otp_signup_redirect or redirect"/>
                            <input type="hidden" name="otp_signup_request_token" t-att-value="otp_signup_request_token"/>

                            <div class="mb-3">
                                <label for="otp_signup_mobile_verify" class="form-label">Mobile Number</label>
                                <input type="text" name="mobile" id="otp_signup_mobile_verify" class="form-control"
                                       t-att-value="otp_signup_mobile" placeholder="+2010XXXXXXXX" required="required"/>
                            </div>
                            <div class="mb-3">
                                <label for="otp_signup_code" class="form-label">OTP Code</label>
                                <input type="text" name="otp_code" id="otp_signup_code" class="form-control"
                                       placeholder="123456" required="required" inputmode="numeric" autocomplete="one-time-code"/>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">Verify OTP &amp; Create Account</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
