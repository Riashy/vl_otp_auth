<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vl_otp_code_tree" model="ir.ui.view">
        <field name="name">vl.otp.code.tree</field>
        <field name="model">vl.otp.code</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="mobile"/>
                <field name="purpose"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="max_attempts"/>
                <field name="expires_at"/>
                <field name="gateway_status_code"/>
                <field name="gateway_status_message"/>
                <field name="last_error"/>
            </tree>
        </field>
    </record>

    <record id="view_vl_otp_code_form" model="ir.ui.view">
        <field name="name">vl.otp.code.form</field>
        <field name="model">vl.otp.code</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="login"/>
                            <field name="mobile"/>
                            <field name="mobile_digits"/>
                            <field name="purpose"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="request_token"/>
                            <field name="sms_id"/>
                            <field name="attempts"/>
                            <field name="max_attempts"/>
                            <field name="expires_at"/>
                            <field name="used_at"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="gateway_status_code"/>
                            <field name="gateway_status_message"/>
                            <field name="last_error"/>
                        </group>
                        <group>
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vl_otp_codes" model="ir.actions.act_window">
        <field name="name">OTP Codes</field>
        <field name="res_model">vl.otp.code</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
