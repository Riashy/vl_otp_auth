<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_otp_extension" inherit_id="web.login" name="Login with OTP Extension">
        <xpath expr="//form" position="after">
            <div id="vl_otp_login_section" class="mt-3 border-top pt-3">
                <p class="text-center small text-muted">أو الدخول السريع عبر الموبايل</p>
                <div class="mb-3">
                    <input type="text" name="mobile_number" id="mobile_number" 
                           class="form-control" placeholder="رقم الموبايل (مثلاً 2010...)"/>
                </div>
                <button type="button" id="btn_send_otp" class="btn btn-secondary w-100 mb-2">
                    إرسال كود التحقق (OTP)
                </button>
                
                <div id="otp_code_container" style="display:none;" class="animate_animated animate_fadeIn">
                    <div class="mb-3">
                        <input type="text" name="otp_code" id="otp_code" 
                               class="form-control" placeholder="أدخل الكود المستلم"/>
                    </div>
                    <button type="button" id="btn_verify_otp" class="btn btn-primary w-100">
                        تأكيد ودخول
                    </button>
                </div>
                <div id="otp_message" class="mt-2 small text-center"></div>
            </div>
        </xpath>
    </template>
</odoo>
