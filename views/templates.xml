<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_otp_extension" inherit_id="web.login" name="Login with OTP">
        <xpath expr="//form[hasclass('oe_login_form')]" position="after">
            <hr/>
            <h5 class="text-center mt-3">أو الدخول برقم الموبايل</h5>
            <div class="form-group mt-3" id="vl_otp_login_section">
                <label for="mobile_number">رقم الموبايل</label>
                <div class="input-group">
                    <input type="text" id="mobile_number" class="form-control" placeholder="مثال: 01012345678" />
                    <button type="button" id="btn_send_otp" class="btn btn-secondary">إرسال الرمز</button>
                </div>
            </div>
            
            <div class="form-group mt-3" id="otp_code_container" style="display: none;">
                <label for="otp_code">رمز التحقق (OTP)</label>
                <div class="input-group">
                    <input type="text" id="otp_code" class="form-control" placeholder="أدخل الرمز المكون من 6 أرقام" />
                    <button type="button" id="btn_verify_otp" class="btn btn-primary">تحقق ودخول</button>
                </div>
            </div>
            <div id="otp_message" class="mt-2 text-center font-weight-bold"></div>
        </xpath>
    </template>

    <template id="checkout_otp_extension" inherit_id="website_sale.payment" name="Checkout OTP">
        <xpath expr="//div[@id='payment_method']" position="before">
            <div class="card mb-3" id="vl_checkout_otp_section">
                <div class="card-body">
                    <h4 class="card-title">التحقق من رقم الهاتف لإتمام الطلب</h4>
                    <div class="form-group">
                        <label for="checkout_mobile">رقم الموبايل</label>
                        <div class="input-group mb-2">
                            <input type="text" id="checkout_mobile" class="form-control" t-att-value="order.partner_id.mobile or order.partner_id.phone"/>
                            <button type="button" id="btn_send_checkout_otp" class="btn btn-secondary">إرسال OTP</button>
                        </div>
                    </div>
                    
                    <div class="form-group" id="checkout_otp_container" style="display: none;">
                        <label for="checkout_otp_code">أدخل رمز التحقق</label>
                        <div class="input-group mb-2">
                            <input type="text" id="checkout_otp_code" class="form-control" />
                            <button type="button" id="btn_verify_checkout_otp" class="btn btn-success">تأكيد الرقم</button>
                        </div>
                    </div>
                    <div id="checkout_otp_message" class="mt-2 text-center font-weight-bold"></div>
                    
                    <input type="hidden" id="is_otp_verified" value="0"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>