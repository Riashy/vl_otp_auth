<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_otp_extension" inherit_id="web.login" name="Login with OTP Extension">
        <xpath expr="//form" position="after">
            
            <div id="vl_otp_login_section" class="mt-4 border-top pt-4">
                <div class="text-center mb-3">
                    <span class="badge rounded-pill bg-light text-dark border">أو الدخول السريع</span>
                </div>
                
                <div class="mb-2">
                    <label for="mobile_number" class="form-label small">رقم الموبايل</label>
                    <input type="text" id="mobile_number" name="mobile_number" 
                           class="form-control form-control-lg" 
                           placeholder="201234567890"/>
                </div>

                <button type="button" id="btn_send_otp" class="btn btn-outline-primary w-100 mb-3">
                    <i class="fa fa-paper-plane me-1"/> إرسال كود التحقق
                </button>
                
                <div id="otp_code_container" style="display: none;">
                    <div class="mb-2">
                        <label for="otp_code" class="form-label small">كود التحقق المستلم</label>
                        <input type="text" id="otp_code" name="otp_code" 
                               class="form-control text-center fw-bold" 
                               style="letter-spacing: 5px;" placeholder="------"/>
                    </div>
                    
                    <button type="button" id="btn_verify_otp" class="btn btn-primary w-100">
                        تأكيد ودخول
                    </button>
                </div>

                <div id="otp_message" class="mt-3 small text-center fw-bold"></div>
            </div>
        </xpath>
    </template>
</odoo>
